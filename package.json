{
  "name": "qwik-cn-site",
  "description": "Qwik 中文网站：可恢复、即时加载的 Web 框架",
  "engines": {
    "node": ">=22.12.0"
  },
  "engines-annotation": "Node 20 已 EOL 且不再获得安全修复，最低要求对齐 Vite 8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build && bun run build.preview",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/ssg/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "preview": "vite preview",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.1"
  },
  "devDependencies": {
    "@qwik.dev/core": "^2.0.0-rc.4",
    "@qwik.dev/router": "^2.0.0-rc.4",
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vite": "8.2.4"
  }
}
